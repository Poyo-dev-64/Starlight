{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Starlight",
  "version": "1.0.0",
  "identifier": "com.starlight.visualizer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Starlight",
        "width": 1280,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420,
        "decorations": false,
        "backgroundColor": "#000000",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
